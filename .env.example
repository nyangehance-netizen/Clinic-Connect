# Copy this file to .env and fill in the values.

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

NODE_ENV=production
PORT=3000

# Where the SQLite database file lives. Back this file up daily.
DATABASE_FILE=data/clinic-connect.db

# Appointment dates and reminders use this time zone.
TZ=Africa/Dar_es_Salaam

# Phone numbers typed as 07XX... are turned into +255 7XX...
DEFAULT_COUNTRY_CODE=255

# How long patients stay signed in.
TOKEN_DAYS=30

# SMS reminder is sent this many minutes before an appointment.
REMINDER_MINUTES_BEFORE=120

# SMS: "console" prints messages to the log. "africastalking" sends real SMS.
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# Set to true when running behind a reverse proxy (Nginx, Caddy, Render, Railway).
TRUST_PROXY=false
